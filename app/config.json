{
  "prometheus": {
    "applications": [
      {
        "name": "default",
        "default": true,
        "dashboards": [
          {
            "groupKind": "pod",
            "tabs": ["Resources"],
            "rows": [
              {
                "name": "cpu_request",
                "title": "CPU Requests",
                "tab": "Resources",
                "graphs": [
                  {
                    "name": "pod_cpu_request_utilization",
                    "title": "Request Utilization",
                    "description": "",
                    "graphType": "line",
                    "metricName": "pod",
                    "valueRounding": 2,
                    "yAxisUnit": "%",
                    "queryExpression": "kubernetes_io:container_cpu_request_utilization{pod_name=~\"{{.name}}\", container_name!=\"POD\"}*100"
                  },
                  {
                    "name": "pod_cpu_request_cores",
                    "title": "Cores Requested",
                    "description": "",
                    "graphType": "line",
                    "metricName": "pod",
                    "queryExpression": "kubernetes_io:container_cpu_request_cores{pod_name=~\"{{.name}}\", container_name!=\"POD\"}"
                  }
                ]
              },
